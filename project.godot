; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LUNA KEMBALILAH KE INDONESIA"
run/main_scene="uid://dlaynb5u4oux0"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://teamgamejam/icon.svg"

[autoload]

Dialogic="*uid://ds2q0uclmolvu"
MusicManager="*uid://ckcn3gc63b2ev"
SceneTransition="*uid://1784sh4378pd"
QuestManager="*uid://b4cwlvdf8ap61"
GameManager="*uid://dsuit4ejlgp7q"

[dialogic]

directories/dch_directory={
"Lulu": "res://teamgamejam/Dialogic/Characters/Lulu.dch",
"Nabila": "res://teamgamejam/Dialogic/Characters/Nabila.dch"
}
directories/dtl_directory={
"BacaBuku": "res://teamgamejam/Dialogic/Timelines/BacaBuku.dtl",
"GreetNabila": "res://teamgamejam/Dialogic/Timelines/GreetNabila.dtl",
"Intro": "res://teamgamejam/Dialogic/Timelines/Intro.dtl",
"IntroBumi": "res://teamgamejam/Dialogic/Timelines/IntroBumi.dtl",
"MendaratSekolah": "res://teamgamejam/Dialogic/Timelines/MendaratSekolah.dtl",
"NabilaSapa": "res://teamgamejam/Dialogic/Timelines/NabilaSapa.dtl",
"NabilaTeman": "res://teamgamejam/Dialogic/Timelines/NabilaTeman.dtl",
"TibaDiSekolah": "res://teamgamejam/Dialogic/Timelines/TibaDiSekolah.dtl"
}
layout/style_directory={
"": "res://teamgamejam/Dialogic/Styles/BubbleStyle.tres",
"BubbleStyle": "res://teamgamejam/Dialogic/Styles/BubbleStyle.tres",
"SpeakerStyle": "res://teamgamejam/Dialogic/Styles/SpeakerStyle.tres",
"VisualNovel": "res://teamgamejam/Dialogic/Styles/VisualNovel.tres"
}
glossary/default_case_sensitive=true
layout/style_list=["res://teamgamejam/Dialogic/Styles/BubbleStyle.tres", "res://teamgamejam/Dialogic/Styles/VisualNovel.tres", "res://teamgamejam/Dialogic/Styles/SpeakerStyle.tres"]
layout/default_style="res://teamgamejam/Dialogic/Styles/BubbleStyle.tres"
variables={}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.05
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"SFX": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 2.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

[file_customization]

folder_colors={
"res://teamgamejam/00_Globals/": "red",
"res://teamgamejam/Assets/": "orange",
"res://teamgamejam/Dialogic/": "yellow",
"res://teamgamejam/Scenes/": "green",
"res://teamgamejam/Scripts/": "teal"
}

